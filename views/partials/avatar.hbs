<span class="avatar{{#if large}} avatar-lg{{/if}}{{#if small}} avatar-sm{{/if}}" data-initial="{{initial person.profile.name person.username}}"{{#if person.profile.hue}} data-hue="{{person.profile.hue}}"{{/if}} aria-hidden="true">{{#if person.profile.image}}<img src="{{person.profile.image}}" alt="" loading="lazy" referrerpolicy="no-referrer">{{/if}}</span>
