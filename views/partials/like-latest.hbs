{{!-- LIKE THEIR LATEST POSTS (a person's page, beside Follow; routes/people.js POST /people/:id/like-latest):
      "♥ Like latest N", N what X's like window allows now (at most LIKE_ALL_MAX). One click (a person's press:
      double clicks are for the whole view only). public/js/post-actions.js `likeLatest` sends it streamed and says the
      progress on the button ("Liking · 12 to go"), the toast says how many X took. Spent: a disabled "More at 3:42 PM",
      as the Inbox's ♥ Like N. Without script, a plain POST back to this page with the toast.
      Context: likeLatest { left, at, max }, the person's `id`. --}}
{{#with @root.likeLatest}}
<form class="like-latest" method="post" action="/people/{{../id}}/like-latest" data-like-latest data-max="{{max}}">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
  {{#if left}}<button type="submit" class="btn like-all-btn">{{> icon-heart}}<span data-like-latest-label>Like latest {{left}}</span></button>
  {{else}}<button type="button" class="btn like-all-btn" disabled>{{> icon-heart}}<span>More {{at}}</span></button>{{/if}}
</form>
{{/with}}
