{{!-- The hidden fields of a rail row's press (views/partials/rail-row.hbs), besides its _csrf (written in each form,
      where verify-security looks for it): what it's for (`person` or `post`, the row's), the page's search and newest
      message (`q`, `upTo`), and the view the page is (`stay` / `stayPost`: its own person or post, `by`, `show`: its
      tab), so the route answers for that view (web.js /inbox/like-all, /inbox/done-all with `rail=1`). --}}
<input type="hidden" name="person" value="{{person}}">
<input type="hidden" name="post" value="{{post}}">
<input type="hidden" name="q" value="{{@root.list.q}}">
<input type="hidden" name="upTo" value="{{@root.upTo}}">
<input type="hidden" name="rail" value="1">
{{#if all}}<input type="hidden" name="all" value="1">{{/if}}
<input type="hidden" name="stay" value="{{@root.list.person}}">
<input type="hidden" name="stayPost" value="{{@root.list.post}}">
<input type="hidden" name="by" value="{{@root.list.by}}">
<input type="hidden" name="show" value="{{@root.list.show}}">
