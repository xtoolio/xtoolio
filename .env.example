# Copy to .env and fill in. Never commit .env.

# Its own database, with a database user that can read and write only this database.
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/xtoolio
# A developer's machine: MONGO_URI above is a TEST database (its own user, readWrite on it alone), and this is the
# deployment's database through a user that can only READ it, for checking production without being able to change
# it. Leave it out on the server. On such a machine also leave X_BEARER_TOKEN empty (Live's subscriptions belong to the
# X app, shared with the deployment), give it its own TOKEN_KEY and SESSION_SECRET, and leave X_APP_OWNER_ID empty to
# use it as a customer would.
# MONGO_LIVE_READ_URI=mongodb+srv://READONLY_USER:PASS@CLUSTER/xtoolio

# What the site calls itself (header, title, Terms, invoices) and the address people know it by (the footer; unset:
# APP_ORIGIN's host). A copy of your own should use its own name.
BRAND_NAME=xtoolio
SITE_DOMAIN=
# Where the code is public (https only): the front page's "The code is public" and the footer's Code link. Unset: hidden.
SOURCE_REPO_URL=
# BETA=true: a "Beta" tag in the header, and the code and self-hosting said to come after the beta (the code's links
# hidden meanwhile, whatever SOURCE_REPO_URL says). Unset or anything else: not in beta.
BETA=

# Sign in with X: developer console → your app → Keys & Tokens → OAuth 2.0 Client ID and Client Secret.
# The app's User authentication settings: Read and write, Web App, callback = APP_ORIGIN + /auth/x/callback.
# (Read and write and Direct message only if SITE_X will send the waitlist's DMs.)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Live (X pushes replies, mentions, your posts and likes as they happen; services/live.js): the app's own Bearer
# token, Keys & Tokens → Bearer Token. The only credential X's activity stream takes. Leave empty for sync alone.
X_BEARER_TOKEN=

# The one address the app answers on (the X callback is built from it; it must be registered in X's console).
APP_ORIGIN=http://127.0.0.1:3100

# Who may create an account (each one starts paid X syncing): X user ids (digits: safest, an id never changes hands)
# and/or usernames, comma-separated, or * for anyone.
# An existing account can always sign back in. Anyone else who signs in goes on the WAITLIST; an admin lets them in
# one at a time (Admin -> Waitlist -> Grant), each told by a DM from SITE_X (see SITE_X below).
ALLOWED_USERNAMES=your_x_username
# How many people can sign up through each account's invite link (Settings → Invites), skipping the waitlist. 0: none.
INVITES_PER_ACCOUNT=5
# Who sees the Admin page (the feedback people send, the waitlist): X USER IDS (digits, not usernames: a username can
# change hands on X), comma-separated. Yours is X_APP_OWNER_ID below if you own the X app. Unset: nobody.
ADMIN_IDS=

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Seals every account's X tokens at rest (AES-256-GCM). Must decode to 32 bytes. Losing it = everyone signs in again.
TOKEN_KEY=

# Hard ceiling on posts read in ONE sync run of one account (X bills ~$0.005 per post read).
SYNC_READ_CAP=100

# Hard ceiling on thread-context posts (what replies answer, read by id) in ONE sync run. Separate from the above.
SYNC_CONTEXT_CAP=2000

# Hard ceiling on profiles looked up in ONE sync run (X bills ~$0.01 per user).
# Only new people and profiles past their refresh (services/syncPrefs.js: your top 50 weekly, others monthly).
SYNC_USER_CAP=1000

# The X user id of the developer account that owns the app (pays the bill): its own reads are priced as Owned Reads
# ($0.001), and its token reads X's real credit balance once a minute (shown only to it, on /usage). Self-hosting for
# yourself: put your own X user id here (from your app's developer account).
X_APP_OWNER_ID=

# Opt-in extras, per run: your liked posts read (new ones plus the look back through older ones, which resumes
# each run until X has nothing older), and likers read on your replies.
LIKES_CAP=1000
LIKERS_CAP=300

# How often the app syncs every account by itself (a run only reads what's new).
SYNC_EVERY_MINUTES=15
# How many accounts the worker syncs at once (passes and new accounts' first reads share them; first reads queue
# first come first served). 5 on a laptop; raise it on the server for a launch (docs/DEPLOY.md).
SYNC_SLOTS=5
# Database connections per process (the driver's default is 100; keep web + worker inside your database's cap).
MONGO_MAX_POOL_SIZE=10

# How long a stopping process may take to finish cleanly (a restart: docs/DEPLOY.md). Under pm2's kill_timeout (30 s).
SHUTDOWN_MS=25000
# How many web copies pm2 runs (ecosystem.config.js). Unset: one per CPU core but one, left for the worker (3 on a
# 4-core droplet), so a resized droplet gets more on its next start. Set it only to override that.
# WEB_INSTANCES=3

PORT=3100
# 127.0.0.1 until the deploy step (nginx + TLS + a real APP_ORIGIN).
HOST=127.0.0.1
# How many proxies sit in front of the app (1 = nginx). 0 if it serves the internet directly: otherwise a visitor's own
# X-Forwarded-For header is believed, and the per-address rate limits can be walked past.
TRUST_PROXY=1

# Prepaid billing (docs/BILLING.md). Every unit of X work an account runs is charged to its balance at X's cost x the
# multiplier. false: the charges are still written (a shadow bill) but nothing is gated and nothing asks for money.
METERED_BILLING_ENABLED=false
# The markup on X's cost, in percent: 50 = x1.5. One account can get a lower one (never higher): npm run margin --
# <username> <multiplier>.
MARGIN_MARKUP_PCT=50
# The markup at the full rate stops at this many dollars for one account in a calendar month (UTC); past it, the rate
# is MARKUP_AFTER_CAP_PCT until the month turns (it covers card processing on big top-ups). 0 = the full rate always.
MARKUP_CAP_USD=50
MARKUP_AFTER_CAP_PCT=15
# The markup on onboarding, in percent: reading your history (and the look back through your likes). The only read at
# this rate; outside the monthly threshold's count.
BULK_MARKUP_PCT=15

# The footer's credit, "Made with 🫶 in <place> by @<handle>". Both, or no credit.
FOOTER_MADE_BY=
FOOTER_MADE_IN=
# A unit of X work starts only while the balance is above this many cents.
METERED_FLOOR_CENTS=0
# Whole dollars. A new account's first top-up is at least the deposit; then any of the top-up amounts.
DEPOSIT_USD=20
# Likestorm only (no syncing, pay per storm): its first top-up can be this small instead.
STORM_DEPOSIT_USD=10
# Credit an admin's Invite (Admin -> Waitlist, by @handle) puts on the person's balance at their first sign-in. 0: none.
INVITE_CREDIT_USD=0
TOPUP_AMOUNTS_USD=10,25,50,100
# Auto-refill (each account opts in, with a saved card): at or under this balance, charge the card. The amount is the
# account's choice of the top-up amounts; this one until it picks.
AUTO_REFILL_THRESHOLD_CENTS=500
AUTO_REFILL_USD=25

# The site's own Stripe account (only for charging other people; a self-hosted copy for yourself needs none).
# Without a secret key nothing can be paid. Test mode locally:
#   stripe listen --forward-to 127.0.0.1:3100/stripe/webhook    (prints the whsec_ to put below)
# Live: dashboard -> Webhooks -> APP_ORIGIN/stripe/webhook, events checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Who runs the site (Stripe's invoices, /terms, /privacy), under which law, and the X handle people DM about their
# account (refunds, questions; without the @). Unset: the entity is BRAND_NAME and the legal pages say to reach us on
# X; set them before taking money.
LEGAL_ENTITY=
LEGAL_JURISDICTION=
CONTACT_X=
# The site's own X account (without the @): linked in the footer, the waitlist page says to follow it, and once it
# signs in to the site as an account (its sign-in also asks X for dm.write) it DMs the people let in. Unset: none of those.
SITE_X=

# Set per process by ecosystem.config.js (pm2); leave unset for a plain `npm start` (web + scheduler in one).
# PROC_ROLE=web
# SCHEDULER_ENABLED=true
